#
# Candidate second toolchain (Phase 5E): Flutter 3.50.0. NOT the supported baseline; the baseline
# stays in pins.env (Flutter 3.47.9). Use it with the lab scripts through PINS_FILE, in a separate
# lab directory, for example:
#
#   PINS_FILE=$PWD/pins-3.50.0.env LAB=~/.cache/flutter-ota-lab-350 ./scripts/fetch_engine.sh
#
# Every value was resolved from official upstream sources on 2026-11-13.

# Flutter stable 3.50.0 (released 2026-11-11), from releases_linux.json and tag 3.50.0.
FLUTTER_VERSION=3.50.0
FLUTTER_COMMIT=ab2912035e160d9cad6306df307576da6128ebdb

# Engine commit the stock 3.50.0 artifacts were built from (bin/internal/engine.version).
# The tag differs from it only in bin/internal/engine.version.
ENGINE_COMMIT=371f77202a73e8dff57a8b3bff75bca55c090aee

# Dart SDK in that engine (DEPS 'dart_revision'): Dart 3.14.0.
DART_VERSION=3.14.0
DART_REVISION=fa8c1270c374c1346931583a17c3b7f278d3822d

# Target device ABI.
ANDROID_ABI=arm64-v8a

# Same depot_tools revision as the baseline (not auto-updated).
DEPOT_TOOLS_REV=1afcf0756e47f3a6ee82d7736b9fcda2d57b268e
# Android toolchain pinned by the engine's DEPS (CIPD flutter/android/sdk/all version:37v2),
# unchanged from the baseline: NDK 28.2.13676358, SDK platform 36, build-tools 36.1.0.
ANDROID_NDK_VERSION=28.2.13676358
