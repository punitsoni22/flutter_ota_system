#
# Pinned toolchain for the Phase 1 bytecode-engine prototype. Every value was resolved from
# official upstream sources on 2026-11-12 (see ../../docs/architecture/phase-1-prototype-report.md).

# Flutter stable 3.47.9 (released 2026-10-29), from releases_linux.json and tag 3.47.9.
FLUTTER_VERSION=3.47.9
FLUTTER_COMMIT=c197ca5199e9ee5661e865596c9c07294dfab51c

# Engine commit the stock 3.47.9 artifacts were built from (bin/internal/engine.version).
# The tag is 3 commits ahead of it, changing only framework Dart files and the changelog.
ENGINE_COMMIT=89c39edfdfae2949f6806e4a315c0c08522238b7

# Dart SDK in that engine (DEPS 'dart_revision'): Dart 3.13.7.
DART_VERSION=3.13.7
DART_REVISION=416e33b0ffaef062a60ec966bb8c82ed2b83f128

# Target device ABI.
ANDROID_ABI=arm64-v8a

# Recorded during the Phase 1 run (2026-11-12).
# depot_tools revision used by fetch_engine.sh (not auto-updated afterwards).
DEPOT_TOOLS_REV=1afcf0756e47f3a6ee82d7736b9fcda2d57b268e
# Android toolchain pinned by the engine's DEPS (CIPD flutter/android/sdk/all version:37v2):
# NDK 28.2.13676358, SDK platform 36, build-tools 36.1.0.
ANDROID_NDK_VERSION=28.2.13676358
# App build: Flutter's configured JDK (JetBrains Runtime 21.0.11), Gradle 9.3.1 (wrapper from
# flutter create), Android Gradle Plugin as generated by Flutter 3.47.9.
