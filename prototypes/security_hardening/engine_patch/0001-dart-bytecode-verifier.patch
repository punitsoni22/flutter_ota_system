@@ -0,0 +1,48 @@
+// Copyright 2026 The Punit Authors
+// SPDX-License-Identifier: Apache-2.0
+//
+// Flutter OTA System prototype patch (Phase 3C): load-time verification of Dart bytecode in
+// dynamic modules. Not part of the upstream Dart SDK.
+
+#ifndef RUNTIME_VM_BYTECODE_VERIFIER_H_
+#define RUNTIME_VM_BYTECODE_VERIFIER_H_
+
+#include "vm/globals.h"
+
+#if defined(DART_DYNAMIC_MODULES)
+
+namespace dart {
+
+class Bytecode;
+class Function;
+class Zone;
+
+namespace bytecode {
+
+// Verifies one function's bytecode after the reader has built its object pool and exception
+// handlers, before any of the module's code can run. Returns nullptr when the bytecode is valid,
+// otherwise a zone-allocated description of the first violation.
+//
+// Checked (see docs/architecture/bytecode-verifier.md in the Flutter OTA System repository):
+//  - every opcode is a public, non-reserved opcode allowed in modules (no FfiCall, ExternalCall,
+//    Trap, RecordCoverage, VM-internal or breakpoint opcodes); no truncated instruction;
+//  - the function starts with Entry/EntryOptional/EntrySuspendable; the parameter prologue
+//    consumed by CopyParameters has the exact LoadConstant shape; Frame only in the prologue;
+//  - register operands inside the frame, signed operands inside frame/parameters;
+//  - jump and exception-handler targets on instruction boundaries; handlers start with SetFrame;
+//  - object pool operands in range and of the kind the interpreter casts them to (calls:
+//    Function/String + argument descriptor whose size equals the instruction's argument count;
+//    fields: Field and an offset equal to Field::HostOffset(); classes, types, type arguments,
+//    subtype test caches, record types, closures); constants are tagged objects;
+//  - stack depth on every path (interval dataflow): no pop below the frame floor, bounded growth,
+//    no execution past the end of the function.
+const char* VerifyBytecode(Zone* zone,
+                           const Function& function,
+                           const Bytecode& bytecode);
+
+}  // namespace bytecode
+}  // namespace dart
+
+#endif  // defined(DART_DYNAMIC_MODULES)
+
+#endif  // RUNTIME_VM_BYTECODE_VERIFIER_H_
