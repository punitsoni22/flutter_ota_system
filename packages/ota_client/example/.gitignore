# The Android project (android/) is kept in Git so the demo runs with `flutter run`.
# android/.gitignore covers its generated files (Gradle wrapper jar, local.properties, keystores).
# Other platforms are not supported: do not commit them.
/ios/
/linux/
/macos/
/windows/
/web/

# Flutter/Dart build output and tool state
/build/
/android/app/debug
/android/app/profile
/android/app/release
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
.metadata
