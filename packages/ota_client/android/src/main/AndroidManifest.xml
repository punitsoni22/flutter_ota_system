<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Runs at process start, before Application.onCreate and before any Flutter engine,
             so every engine in the process (UI, push, background work) loads the same code. -->
        <provider
            android:name="io.github.punitsoni22.flutter_ota_system.OtaBootProvider"
            android:authorities="${applicationId}.ota_boot"
            android:exported="false"
            android:initOrder="1000" />
        <!-- Bytecode runtime (Phase 4): loads a NEW patch once in this separate process before it
             is activated. Same UID as the app (Android isolated processes cannot start Flutter
             in release builds). Not exported: only this app can bind it. -->
        <service
            android:name="io.github.punitsoni22.flutter_ota_system.FlutterOtaVerifierService"
            android:process=":flutter_ota_verify"
            android:exported="false" />
    </application>
</manifest>
