# Punit: LOCAL DEVELOPMENT settings for docker-compose.yml.
#
#   cp .env.example .env
#
# Every value below is a deliberately fake, local-only default. None of them is a secret and
# none of them may be used on a server. For a server, see deploy/.env.example and docs/security.md.
# The API refuses to start with these values when OTA_ENV=production.

# ---- Ports on your machine ----------------------------------------------------------------
PUNIT_API_PORT=8000
PUNIT_CDN_PORT=8080
# Postgres is bound to 127.0.0.1 only.
PUNIT_POSTGRES_PORT=5432

# ---- Database (local container only) ------------------------------------------------------
POSTGRES_USER=punit
POSTGRES_PASSWORD=local-dev-only-not-a-secret
POSTGRES_DB=punit

# ---- API ----------------------------------------------------------------------------------
OTA_ENV=development
# Admin API key for the CLI, the demo scripts and the /admin page.
OTA_ADMIN_API_KEY=local-dev-admin-key-not-a-secret
OTA_DEVICE_JWT_SECRET=local-dev-device-jwt-secret-not-a-secret
# Changing this reshuffles every rollout group.
OTA_ROLLOUT_HMAC_SECRET=local-dev-rollout-secret-not-a-secret

# Where devices download patch files from: the nginx "CDN" container.
#   Host / iOS simulator / desktop:  http://localhost:8080/cdn
#   Android emulator:                http://10.0.2.2:8080/cdn
#   Physical phone on your Wi-Fi:    http://<your-laptop-LAN-IP>:8080/cdn
# The demo scripts work with any of them (they fetch through the Compose network).
OTA_CDN_BASE_URL=http://localhost:8080/cdn

# "true" = FastAPI also serves /cdn/patches on the API port (single-tunnel testing only).
OTA_SERVE_ARTIFACTS_LOCALLY=false

# ---- Signing (LOCAL DEVELOPMENT KEY) ------------------------------------------------------
# ./scripts/generate_dev_signing_key.sh creates an ES256 key inside the Docker volume
# "punit_keys". It never touches the repository. It is NOT suitable for production.
OTA_SIGNING_KEY_ID=local-dev-1
# false = the API refuses to start without a key instead of silently creating one.
OTA_AUTO_GENERATE_SIGNING_KEY=false

# ---- Demo ---------------------------------------------------------------------------------
PUNIT_DEMO_APP=punit-demo
PUNIT_DEMO_CHANNEL=dev
PUNIT_DEMO_RELEASE=1.0.0+1
PUNIT_DEMO_PLATFORM=android
PUNIT_DEMO_ARCH=arm64-v8a
