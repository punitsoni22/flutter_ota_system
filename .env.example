# Flutter OTA System: LOCAL DEVELOPMENT settings for docker-compose.yml.
#
# You normally do not copy this file by hand: `./flutter-ota-system.sh setup` creates .env from it and replaces
# the four "not-a-secret" values below (POSTGRES_PASSWORD, OTA_ADMIN_API_KEY, OTA_DEVICE_JWT_SECRET,
# OTA_ROLLOUT_HMAC_SECRET) with random local values. It never changes an existing .env.
# (`cp .env.example .env` also works; the stack then runs with these fake values.)
#
# Every value in this file is a deliberately fake, local-only default. None of them is a secret
# and none of them may be used on a server. For a server, see deploy/.env.example and
# docs/security.md. The API refuses to start with these values when OTA_ENV=production.
#
# Required = the stack needs a value; every required variable has a working default here.

# ---- Compose project (optional) -----------------------------------------------------------
# Default "flutter-ota-system": containers flutter-ota-system-api-1 ..., volumes flutter-ota-system_pgdata, flutter-ota-system_artifacts, flutter-ota-system_keys.
# Change it (and the ports and FLUTTER_OTA_API_IMAGE) only to run a second stack next to the first one.
#COMPOSE_PROJECT_NAME=flutter-ota-system
# Locally built API image tag. Optional, default flutter-ota-system-api:local.
#FLUTTER_OTA_API_IMAGE=flutter-ota-system-api:local
# Optional: also publish Postgres on 127.0.0.1:FLUTTER_OTA_POSTGRES_PORT (off by default).
#COMPOSE_FILE=docker-compose.yml:docker/compose.postgres-port.yml

# ---- Ports on your machine (required) -----------------------------------------------------
FLUTTER_OTA_API_PORT=8000
FLUTTER_OTA_CDN_PORT=8080
# Used only with docker/compose.postgres-port.yml (always bound to 127.0.0.1).
FLUTTER_OTA_POSTGRES_PORT=5432
# Optional. Default 127.0.0.1 (this computer only). 0.0.0.0 = reachable from your whole network.
#FLUTTER_OTA_BIND_ADDRESS=127.0.0.1

# ---- Database (local container only, required) --------------------------------------------
POSTGRES_USER=flutter_ota
# Used only when the database volume is first created. Changing it later breaks the login:
# keep it, or reset the stack (./flutter-ota-system.sh reset).
POSTGRES_PASSWORD=local-dev-only-not-a-secret
POSTGRES_DB=flutter_ota

# ---- API (required) -----------------------------------------------------------------------
OTA_ENV=development
# Admin API key for the CLI, the demo scripts and the /admin page.
OTA_ADMIN_API_KEY=local-dev-admin-key-not-a-secret
# Changing it makes every device register again (harmless locally).
OTA_DEVICE_JWT_SECRET=local-dev-device-jwt-secret-not-a-secret
# Changing this reshuffles every rollout group.
OTA_ROLLOUT_HMAC_SECRET=local-dev-rollout-secret-not-a-secret

# Where devices download patch files from: the nginx "CDN" container.
#   Host, USB phone with `adb reverse`, iOS simulator, desktop:  http://localhost:8080/cdn
#   Android emulator:                                           http://10.0.2.2:8080/cdn
#   Physical phone on your Wi-Fi:                               http://<your-laptop-LAN-IP>:8080/cdn
# Use the same port as FLUTTER_OTA_CDN_PORT. The demo scripts work with any of them.
OTA_CDN_BASE_URL=http://localhost:8080/cdn

# "true" = FastAPI also serves /cdn/patches on the API port (single-tunnel testing only).
OTA_SERVE_ARTIFACTS_LOCALLY=false

# ---- Signing (LOCAL DEVELOPMENT KEY) ------------------------------------------------------
# ./flutter-ota-system.sh setup creates an ES256 key ONCE inside the Docker volume "<project>_keys" (default
# flutter-ota-system_keys). It never touches the repository, is never regenerated on restart, and is NOT
# suitable for production. Production keys: docs/security.md.
OTA_SIGNING_KEY_ID=local-dev-1
# false = the API refuses to start without a key instead of silently creating one.
OTA_AUTO_GENERATE_SIGNING_KEY=false

# ---- Demo (optional) ----------------------------------------------------------------------
FLUTTER_OTA_DEMO_APP=flutter-ota-system-demo
FLUTTER_OTA_DEMO_CHANNEL=dev
FLUTTER_OTA_DEMO_RELEASE=1.0.0+1
FLUTTER_OTA_DEMO_PLATFORM=android
FLUTTER_OTA_DEMO_ARCH=arm64-v8a
