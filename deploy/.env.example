# Copy to .env (never commit it) and fill in every value.
# Random values: openssl rand -hex 32

# The server's domain; point its DNS A record at the VPS first.
OTA_DOMAIN=ota.example.com

POSTGRES_PASSWORD=
# For the CLI (OTA_API_KEY) and the admin page.
OTA_ADMIN_API_KEY=
OTA_DEVICE_JWT_SECRET=
# Changing this later reshuffles every rollout group.
OTA_ROLLOUT_HMAC_SECRET=
# Name of the signing key; apps embed "<id>:<public key>".
OTA_SIGNING_KEY_ID=prod-1
