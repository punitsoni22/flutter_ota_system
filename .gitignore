# ---- Secrets and local state: never commit ------------------------------------------------
.env
.env.*
!.env.example
deploy/.env
deploy/cloud.env
deploy/backups/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
keys/
# Source code folder of the flutter_ota CLI (key management code, never key files).
!packages/flutter_ota_cli/lib/src/keys/
.local/
secrets/
# ./flutter-ota-system.sh backup output (contains the signing key and .env) and setup temp files
backups/
.env.tmp.*

# ---- Python -------------------------------------------------------------------------------
.venv/
.venv-cli/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
backend/data/

# ---- Flutter / Dart -----------------------------------------------------------------------
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
android/key.properties
**/android/local.properties
**/android/.gradle/
**/android/.cxx/
